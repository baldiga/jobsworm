# Copy to .env.local (git-ignored) and fill in. Never commit real values.
# Every variable the code reads is listed here, grouped by what needs it.
# Anything you paste into a chat, an issue or a screenshot is leaked: rotate it.

# =============================================================================
# REQUIRED — the site and the ATS ingester
# =============================================================================

# Supabase. Locally, `supabase start` prints all three. Hosted: Project
# Settings -> API, or `supabase projects api-keys --project-ref <ref>`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Bypasses row-level security. Never give it a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
# Optional alias the Python worker and scripts accept; defaults to the URL above.
SUPABASE_URL=

# The site's own public address: canonical URLs, sitemap, robots.txt, and the
# bot user-agent the scrapers send. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vercel Cron sends `Authorization: Bearer $CRON_SECRET` to /api/cron/*.
# Any long random string: openssl rand -hex 32
CRON_SECRET=

# =============================================================================
# SEEDING — scripts/seed/index.ts
# =============================================================================

# New companies are spread over this many hours so the first ingest does not
# hit every ATS at once. Set 0 locally to make them all due immediately.
SEED_STAGGER_HOURS=48
# Pause between 50-row upsert batches, so a small database is not swamped.
SEED_PAUSE_MS=1000

# =============================================================================
# PIPELINE — the Python worker (apps/worker) and the importer
# =============================================================================

# Salt for hashing social poster identities. The worker refuses to store social
# posts without it. Generate: python -c "import secrets;print(secrets.token_hex(24))"
POSTER_HASH_SALT=

# Search backend for Facebook permalink discovery (fb-posts). Free tier:
# 2,000 queries/month at https://brave.com/search/api/. Without it discovery
# falls back to DuckDuckGo, which throttles after about one query.
BRAVE_SEARCH_API_KEY=

# Residential proxy / cloud browser, the last rung of the fetch ladder. Only
# the Facebook group-feed reader (fb-scrape) needs it.
FLOPPYDATA_API_KEY=

# Facebook groups through an Apify actor (fb-apify). Without a token the
# command and the social.yml workflow do nothing.
# Read "Data sources and the law" in the README first: use is at your own risk.
APIFY_TOKEN=
# Leave UNSET. The default (memo23/facebook-public-group-posts-scraper) billed
# ~$1.65 per 1,000 posts; apify/facebook-groups-scraper billed $5-7 per 1,000.
APIFY_ACTOR=
# Set to 1 only if you accept the dearer actor as an automatic fallback.
APIFY_ALLOW_PAID_FALLBACK=

# =============================================================================
# OPTIONAL — operator identity (lib/contact.ts). Each feature hides when unset.
# =============================================================================

# WhatsApp number for the bug-report button and footer, digits only,
# international format without the plus: 972501234567
NEXT_PUBLIC_CONTACT_WHATSAPP=
# Where a recruiter writes when a payment does not confirm.
NEXT_PUBLIC_CONTACT_EMAIL=
# Credited in the footer and named as accessibility coordinator.
NEXT_PUBLIC_OWNER_NAME=
NEXT_PUBLIC_OWNER_URL=
# Google Analytics measurement ID (G-XXXXXXXXXX). Unset: no GA script at all.
NEXT_PUBLIC_GA_ID=

# =============================================================================
# OPTIONAL — analytics (PostHog, EU region)
# =============================================================================

# The project token (phc_...). Public by design: it can write events and
# nothing else, and it ships in the page.
NEXT_PUBLIC_POSTHOG_KEY=
# Our own origin. next.config.ts rewrites /hive/* to the PostHog hosts, so
# content blockers do not silently remove a biased slice of the audience.
NEXT_PUBLIC_POSTHOG_HOST=/hive
# SERVER ONLY. A personal API key (phx_...) with the single scope Query: Read,
# used by the hourly rollup. The project token above cannot read.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_API_HOST=https://eu.posthog.com

# =============================================================================
# OPTIONAL — admin and paid placement
# =============================================================================

# Comma-separated sign-in emails allowed into /admin. Anyone else gets a 404,
# not a 403. UNSET ADMITS NOBODY, which is how a misconfigured deploy should fail.
ADMIN_EMAILS=

# fungies.io checkout (merchant of record). Without FUNGIES_WEBHOOK_SECRET the
# checkout route answers 503 and listings are settled by invoice instead, so
# the whole recruiter payment flow is optional.
FUNGIES_KEY=
FUNGIES_SECRET=
# HMAC secret. The signature arrives as `sha256_<hex>` — an underscore.
FUNGIES_WEBHOOK_SECRET=
# Override only if fungies changes the header name (default x-fngs-signature).
FUNGIES_SIGNATURE_HEADER=
# Checkout host is <slug>.app.fungies.io. Note the `.app.`.
FUNGIES_STORE_SLUG=
# One offer and one checkout element per package; `pnpm fungies:sync` prints them.
FUNGIES_OFFER_7=
FUNGIES_OFFER_14=
FUNGIES_OFFER_21=
FUNGIES_OFFER_28=
FUNGIES_ELEMENT_7=
FUNGIES_ELEMENT_14=
FUNGIES_ELEMENT_21=
FUNGIES_ELEMENT_28=
# PREVIEW ONLY. Acts on testMode events. Never in production: free adverts.
FUNGIES_ALLOW_TEST=
