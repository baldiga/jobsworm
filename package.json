{
  "name": "jobsworm",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "lint": "pnpm --filter web lint",
    "test": "vitest run",
    "db:migrate": "supabase db push",
    "seed": "tsx scripts/seed/index.ts",
    "ingest:once": "tsx packages/adapters/src/cli.ts --once",
    "detect:ats": "python scripts/seed/detect_ats.py",
    "export:samples": "tsx scripts/export-samples.ts",
    "import:scraped": "tsx packages/adapters/src/import-cli.ts",
    "audit:index": "tsx scripts/audit-index.ts",
    "scrape": "cd apps/worker && python -m jobswarm_scrape.cli",
    "post:job": "tsx scripts/post-employer-job.ts",
    "redecompose": "tsx scripts/redecompose.ts",
    "fungies:sync": "tsx scripts/fungies-sync.ts",
    "typecheck": "pnpm --filter @jobsworm/core exec tsc --noEmit -p . && pnpm --filter @jobsworm/adapters exec tsc --noEmit -p ."
  },
  "devDependencies": {
    "supabase": "^2.34.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "@types/node": "^22.13.1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.48.1",
    "dotenv": "^16.4.7",
    "next": "16.3.4",
    "@jobsworm/core": "workspace:*",
    "@jobsworm/adapters": "workspace:*"
  }
}
