{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter web build",
  "outputDirectory": "apps/web/.next",
  "crons": [
    {
      "path": "/api/cron/ingest?limit=60",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/ingest?limit=60",
      "schedule": "10 0 * * *"
    },
    {
      "path": "/api/cron/ingest?limit=60",
      "schedule": "20 0 * * *"
    },
    {
      "path": "/api/cron/ingest?limit=60",
      "schedule": "30 0 * * *"
    },
    {
      "path": "/api/cron/ingest?limit=20",
      "schedule": "7 * * * *"
    },
    {
      "path": "/api/cron/posthog-rollup",
      "schedule": "17 * * * *"
    }
  ]
}
